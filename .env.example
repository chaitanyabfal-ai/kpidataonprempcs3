# Copy this file to .env and fill in real values. Never commit .env.

## --- Syncthing / local ingestion --------------------------------------
SYNC_WATCH_DIR=/path/to/syncthing/local/folder
SYNC_IGNORE_SUFFIXES=.tmp,.part,.swp
SYNC_SETTLE_SECONDS=0.5
DELETE_AFTER_UPLOAD=true

## --- Garage S3 (over Tailscale) ----------------------------------------
GARAGE_ENDPOINT_URL=http://100.84.7.71:3900/
GARAGE_ACCESS_KEY_ID=GK37638e5ba22ac89745949e25
GARAGE_SECRET_ACCESS_KEY=303761d744bc66e522dfeaa3fc370283cb8d916123f02235f6435c690dc5da33
GARAGE_BUCKET=sensor-data-staging
GARAGE_REGION=garage

## --- AWS ----------------------------------------------------------------
AWS_REGION=us-east-1
AWS_RAW_BUCKET=raw-sensor-data-bucket
AWS_RAW_PREFIX=raw-sensor-data/
SNS_TOPIC_ARN=
SQS_QUEUE_URL=
SQS_DLQ_URL=
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=60

# Standard AWS credential env vars also work if you're not using an
# instance role: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN

## --- KPI configuration ---------------------------------------------------
# Comma-separated "sensor_id:min:max" triples. Values outside range count
# as a threshold breach for that sensor.
KPI_THRESHOLDS=
KPI_HOURLY_ALIGN_MINUTES=60

## --- Paths (override only if you need a non-default layout) -------------
DATA_DIR=
LOG_DIR=
KPI_REPORTS_DIR=
